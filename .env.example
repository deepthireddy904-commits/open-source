# ==============================================================================
# PR Chronicler & Learning Dispatcher Environment Configuration
# ==============================================================================

# Google Generative AI API Key (required for Gemini Flash synthesis)
GOOGLE_API_KEY=your_google_api_key_here

# Model Identifier: Gemini Flash (e.g., gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1

# GitHub Personal Access Token (PAT) for API hydration (avoids rate limits: 60 req/hr -> 5000 req/hr)
GITHUB_TOKEN=your_github_token_here

# GitHub Webhook Secret (optional HMAC SHA-256 verification)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# SMTP Configuration (e.g. Gmail: smtp.gmail.com:587 with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true

# Recipient email address to receive reflections (defaults to SMTP_EMAIL if omitted)
NOTIFICATION_RECIPIENT_EMAIL=your_target_inbox@example.com

# Safety & Operational Safeguards
MAX_DIFF_CHARACTERS=50000
DRY_RUN_SMTP=false
